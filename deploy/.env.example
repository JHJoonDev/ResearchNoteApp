# ==============================================================================
# LabHub 배포 환경변수 설정 가이드 (deploy/.env.example)
#
# 주의: 이 파일을 .env로 복사한 뒤 실제 비밀 값으로 채워 넣으세요.
# .env 파일과 비밀 키는 절대로 Git 저장소나 Docker 이미지에 포함되어서는 안 됩니다.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 도메인 및 네트워크 설정
# ------------------------------------------------------------------------------
# 서비스에 접속할 도메인 (Caddy가 자동으로 HTTPS 인증서를 발급받습니다)
# 로컬 테스트 시에는 localhost 로 설정하세요.
APP_DOMAIN=localhost

# Let's Encrypt / ZeroSSL 인증서 만료 알림용 이메일
ACME_EMAIL=admin@example.ac.kr

# 호스트에 바인딩할 HTTP/HTTPS 포트 (기본값: 80, 443)
# E2E 테스트 및 로컬 개발용 포트(5000, 5173)와 충돌하지 않도록 주의하세요.
HTTP_PORT=80
HTTPS_PORT=443

# CORS 허용 출처 (브라우저 접속 URL, 기본적으로 https://${APP_DOMAIN}과 일치)
CORS_ORIGIN=https://localhost

# 역방향 프록시 홉 수 (Caddy 1홉 구조에 맞춰 docker-compose.yml에 TRUST_PROXY: 1로 기본 지정됨)
# 외부 로드밸런서(ALB, Nginx 등)를 앞단에 추가로 둘 경우 홉 수(예: 2)에 맞춰 조정하세요.
# TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. 데이터베이스 설정 (MongoDB 단일 노드 Replica Set)
# ------------------------------------------------------------------------------
# MongoDB 관리자(root) 계정 정보
MONGO_ROOT_USERNAME=admin
# 생성 방법: openssl rand -hex 32
MONGO_ROOT_PASSWORD=CHANGE_THIS_TO_SECURE_RANDOM_HEX_AT_LEAST_32_CHARS

# LabHub 애플리케이션 전용 데이터베이스 사용자 정보
DB_NAME=labhub
MONGO_APP_USERNAME=labhub
# 생성 방법: openssl rand -hex 32
MONGO_APP_PASSWORD=CHANGE_THIS_TO_SECURE_RANDOM_HEX_AT_LEAST_32_CHARS

# ------------------------------------------------------------------------------
# 3. 애플리케이션 보안 비밀키
# ------------------------------------------------------------------------------
# JWT 세션 토큰 서명 비밀키 (최소 32자 이상의 임의 문자열)
# 생성 방법: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_HEX_AT_LEAST_32_CHARS

# 데이터 암호화 키 (운영 환경 필수)
# MFA(TOTP) 비밀키 등 서버 측 데이터 암호화(AES-256-GCM)에 사용됩니다.
# (참고: 사용자 서명 개인키는 이 키가 아니라 사용자 비밀번호에서 scrypt로 유도한 키로 암호화됩니다.)
# 요구 형식: 32바이트 Base64 인코딩 문자열
# 생성 방법: openssl rand -base64 32
DATA_ENCRYPTION_KEY=CHANGE_THIS_TO_BASE64_32_BYTE_SECRET

# 초기 시스템 관리자 계정 생성용 일회성 코드
# 생성 방법: openssl rand -hex 16
SETUP_TOKEN=CHANGE_THIS_TO_RANDOM_SETUP_CODE

# ------------------------------------------------------------------------------
# 4. 기관 및 보존 설정
# ------------------------------------------------------------------------------
# 소속 기관명 (PDF 보고서 및 증빙 매니페스트에 기재됨)
ORG_NAME=연구실

# 연구노트 법정/규정 보존 연한 (기본값: 30년, 기관 자체규정으로 조정 가능)
RETENTION_YEARS=30

# ------------------------------------------------------------------------------
# 5. 시점인증(TSA: Time Stamping Authority) 어댑터 설정
# ------------------------------------------------------------------------------
# 기본값: none (시점인증 미설정 상태, 전자서명 및 증빙 봉인은 정상 처리됨)
# 선택 가능 값: none | rfc3161 | enote-portal | dev-local
TIMESTAMP_PROVIDER=none

# [선택 옵션 A] RFC 3161 표준 TSA 연동 설정 예시
# TIMESTAMP_PROVIDER=rfc3161
# TSA_URL=https://tsa.example.org/timestamp
# TSA_USERNAME=your_tsa_account
# TSA_PASSWORD=your_tsa_password
# 컨테이너 내부에 마운트된 루트/중간 CA 인증서 파일 경로 (PEM 형식)
# TSA_CA_CERT=/app/certs/tsa-ca.pem
# TSA_POLICY_OID=1.2.3.4.5.6

# [선택 옵션 B] 국가R&D 전자연구노트 포털 연동 설정 예시
# 대상: 국가연구개발사업을 수행하는 연구기관 (한국특허전략개발원 안내 기준)
# 신청 URL: https://www.e-note.or.kr/enote/timestamp/serviceGuide.do
# 기관 신청 및 승인 후 발급받은 공식 연계 명세에 따라 설정합니다.
# TIMESTAMP_PROVIDER=enote-portal
# ENOTE_CLIENT_ID=YOUR_CLIENT_ID
# ENOTE_CLIENT_SECRET=YOUR_CLIENT_SECRET
# ENOTE_ENDPOINT=https://endpoint-from-portal-specification

# ------------------------------------------------------------------------------
# 6. [선택] 서버 검색 엔진 (Meilisearch, 2단계 이후 대규모 환경용)
# ------------------------------------------------------------------------------
# docker-compose.yml에서 meilisearch 서비스 주석 해제 시 필수 (${MEILI_MASTER_KEY:?})
# 생성 방법: openssl rand -hex 32
# MEILI_MASTER_KEY=CHANGE_THIS_TO_SECURE_MEILI_KEY
