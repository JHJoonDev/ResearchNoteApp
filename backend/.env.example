# Local use needs no configuration. Never commit .env or backend/data.
HOST=127.0.0.1
PORT=5000
LOCAL_DB_PORT=27028
DB_NAME=labhub
# Production requires an authenticated MongoDB replica set and HTTPS reverse proxy.
# NODE_ENV=production
# MONGO_URI=mongodb://USER:PASSWORD@DB_HOST:27017/?replicaSet=rs0&authSource=admin
# JWT_SECRET=SET_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
# CORS_ORIGIN=https://YOUR_LAB_DOMAIN
# TRUST_PROXY=1 (Caddy 뒤 홉 수; 사용하지 않으면 비워둠)
# SETUP_TOKEN=SET_A_RANDOM_INITIAL_SETUP_CODE
# ORG_NAME=Your organization name
# PUBLIC_BASE_URL=https://YOUR_LAB_DOMAIN
# MAIL_PROVIDER=none|smtp
# SMTP_HOST=mail.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=labhub@example.org
# SEARCH_PROVIDER=memory|meilisearch
# memory 모드는 프로세스별 저장소이므로 단일 서버 인스턴스에서만 사용하세요.
# MEILI_URL=http://127.0.0.1:7700
# MEILI_API_KEY=
# MEILI_INDEX_UID=labhub_search
# DATA_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_SECRET (required in production)
# TIMESTAMP_PROVIDER=none|rfc3161|enote-portal|dev-local
# TSA_URL=https://tsa.example.org
# TSA_USERNAME=
# TSA_PASSWORD=
# TSA_CA_CERT=C:\\secrets\\tsa-ca.pem
# TSA_POLICY_OID=
# ENOTE_CLIENT_ID=
# ENOTE_CLIENT_SECRET=
# ENOTE_ENDPOINT=
# RETENTION_YEARS=30
# AUDIT_ANCHOR_INTERVAL_MS=86400000
# Phase 3 storage and upload limits. Local storage is the default.
STORAGE_PROVIDER=local
MAX_UPLOAD_MB=200
# STORAGE_PROVIDER=s3 when using S3-compatible object storage.
# S3_ENDPOINT=https://s3.example.org
# S3_BUCKET=labhub
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# OIDC sign-in is disabled unless all four values are set.
# OIDC_ISSUER=https://identity.example.org
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://YOUR_LAB_DOMAIN/api/auth/oidc/callback
# OIDC_LABEL=기관 계정
# METRICS_TOKEN=SET_A_RANDOM_METRICS_TOKEN
# API_KEY_RATE_LIMIT=120
# AI is disabled unless explicitly enabled. No key is required for the server to start.
AI_PROVIDER=none
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_RATE_LIMIT=10
# ANTHROPIC_API_KEY=
